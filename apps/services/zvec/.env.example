ZVEC_HOST=0.0.0.0
ZVEC_PORT=8765
ZVEC_DATA_DIR=/app/data/zvec

# Embedding provider: "local" (sentence-transformers) or "openai" (OpenAI-compatible API)
ZVEC_EMBEDDING_PROVIDER=local
ZVEC_EMBEDDING_MODEL=all-MiniLM-L6-v2
ZVEC_EMBEDDING_DIM=384
# Set to 1 once the model is cached locally to skip HuggingFace network checks
# ZVEC_LOCAL_OFFLINE=1
# Uncomment when using HF mirror in mainland China
# HF_ENDPOINT=https://hf-mirror.com
# ZVEC_LOCAL_MODEL_SOURCE=modelscope

# For the "openai" provider
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# ZVEC_EMBEDDING_MODEL=text-embedding-3-small
# ZVEC_EMBEDDING_DIM=1536
